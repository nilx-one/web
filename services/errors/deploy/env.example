# One project:token entry per reporting project, separated by commas.
# A "*" project marks a shared token whose reports must name their own project.
ERROR_TRASH_INGEST_TOKENS=nilx-one/web:replace-with-at-least-32-random-characters,*:replace-with-a-different-32-character-token
# Optional. Reading the trash back stays disabled until this is set.
ERROR_TRASH_READ_TOKEN=replace-with-a-third-32-character-token
