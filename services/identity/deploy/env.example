PUBLIC_ORIGIN=https://nilx.one
TELOXIDE_TOKEN=replace-with-bot-token
NATIVE_AUTH_SECRET=replace-with-at-least-32-random-bytes
PASSWORD_PEPPER=replace-with-a-different-32-byte-secret
TELEGRAM_OIDC_CLIENT_ID=replace-with-telegram-oidc-client-id
TELEGRAM_OIDC_CLIENT_SECRET=replace-with-telegram-oidc-client-secret
DISCORD_CLIENT_ID=replace-with-discord-application-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
GITHUB_AUTH_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_AUTH_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_EVIDENCE_CLIENT_ID=replace-with-dedicated-read-only-github-oauth-client-id
GITHUB_EVIDENCE_CLIENT_SECRET=replace-with-dedicated-read-only-github-oauth-client-secret
GITHUB_EVIDENCE_ENCRYPTION_KEY=replace-with-64-hex-character-server-owned-key
# aiaiaiai Identity issuer (auth.aiaiaiai.org): all three or none.
# AIAIAIAI_ISSUER=https://auth.aiaiaiai.org
# AIAIAIAI_ISSUER_SIGNING_KEY=replace-with-base64url-32-byte-ed25519-seed
# AIAIAIAI_ISSUER_CLIENTS=[{"client_id":"nilx-one","name":"0x1","redirect_uris":["https://nilx.one/api/v1/auth/aiaiaiai/callback"],"secret_sha256":"<sha256 hex of the client secret>","pub_dress":true}]
# The 0x1 site as a public client of AIS (aiaiaiai-org/4x-ais). It holds no secret;
# the issuer's address is the only setting, and it turns sign-in on.
# AIAIAIAI_SIGN_IN_ISSUER=https://auth.aiaiaiai.org
# Only when /token and the JWKS must be reached somewhere other than the issuer origin:
# AIAIAIAI_SIGN_IN_BACKCHANNEL=https://auth.aiaiaiai.org
