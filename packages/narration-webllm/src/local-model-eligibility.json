{
  "schema": 1,
  "about": "Eligibility of every served local model for a probed device and a declared budget. Owned by nilx-one/ai (src/inference.rs); nilx-one/web keeps a byte-identical copy at packages/narration-webllm/src/local-model-eligibility.json and tests its own reading of the rule against it. Change it here first.",
  "vocabulary": [
    "eligible",
    "over_budget",
    "missing_shader_f16",
    "below_runtime_floor:<WebGPU limit name>"
  ],
  "cases": [
    {
      "name": "a generous budget admits every entry, and the default still runs",
      "device": {
        "shader_f16": true,
        "max_buffer_size": 1073741824,
        "max_storage_buffer_binding_size": 1073741824,
        "max_compute_workgroup_storage_size": 65536,
        "max_storage_buffers_per_shader_stage": 10
      },
      "budget_mb": 4096,
      "expected": {
        "Qwen3-0.6B-q4f16_1-MLC": "eligible",
        "Qwen3-1.7B-q4f16_1-MLC": "eligible",
        "SmolLM2-360M-Instruct-q4f16_1-MLC": "eligible",
        "OLMo-2-0425-1B-Instruct-q4f16_1-MLC": "eligible",
        "Llama-3.2-1B-Instruct-q4f16_1-MLC": "eligible"
      },
      "default": "eligible"
    },
    {
      "name": "a phone-sized budget admits the default and the lighter families",
      "device": {
        "shader_f16": true,
        "max_buffer_size": 1073741824,
        "max_storage_buffer_binding_size": 1073741824,
        "max_compute_workgroup_storage_size": 65536,
        "max_storage_buffers_per_shader_stage": 10
      },
      "budget_mb": 1500,
      "expected": {
        "Qwen3-0.6B-q4f16_1-MLC": "eligible",
        "Qwen3-1.7B-q4f16_1-MLC": "over_budget",
        "SmolLM2-360M-Instruct-q4f16_1-MLC": "eligible",
        "OLMo-2-0425-1B-Instruct-q4f16_1-MLC": "over_budget",
        "Llama-3.2-1B-Instruct-q4f16_1-MLC": "eligible"
      },
      "default": "eligible"
    },
    {
      "name": "a budget that admits the two lightest families but not the default",
      "device": {
        "shader_f16": true,
        "max_buffer_size": 1073741824,
        "max_storage_buffer_binding_size": 1073741824,
        "max_compute_workgroup_storage_size": 65536,
        "max_storage_buffers_per_shader_stage": 10
      },
      "budget_mb": 1000,
      "expected": {
        "Qwen3-0.6B-q4f16_1-MLC": "over_budget",
        "Qwen3-1.7B-q4f16_1-MLC": "over_budget",
        "SmolLM2-360M-Instruct-q4f16_1-MLC": "eligible",
        "OLMo-2-0425-1B-Instruct-q4f16_1-MLC": "over_budget",
        "Llama-3.2-1B-Instruct-q4f16_1-MLC": "eligible"
      },
      "default": "over_budget"
    },
    {
      "name": "the default's requirement, exactly",
      "device": {
        "shader_f16": true,
        "max_buffer_size": 1073741824,
        "max_storage_buffer_binding_size": 1073741824,
        "max_compute_workgroup_storage_size": 65536,
        "max_storage_buffers_per_shader_stage": 10
      },
      "budget_mb": 1404,
      "expected": {
        "Qwen3-0.6B-q4f16_1-MLC": "eligible",
        "Qwen3-1.7B-q4f16_1-MLC": "over_budget",
        "SmolLM2-360M-Instruct-q4f16_1-MLC": "eligible",
        "OLMo-2-0425-1B-Instruct-q4f16_1-MLC": "over_budget",
        "Llama-3.2-1B-Instruct-q4f16_1-MLC": "eligible"
      },
      "default": "eligible"
    },
    {
      "name": "one megabyte under the default's requirement",
      "device": {
        "shader_f16": true,
        "max_buffer_size": 1073741824,
        "max_storage_buffer_binding_size": 1073741824,
        "max_compute_workgroup_storage_size": 65536,
        "max_storage_buffers_per_shader_stage": 10
      },
      "budget_mb": 1403,
      "expected": {
        "Qwen3-0.6B-q4f16_1-MLC": "over_budget",
        "Qwen3-1.7B-q4f16_1-MLC": "over_budget",
        "SmolLM2-360M-Instruct-q4f16_1-MLC": "eligible",
        "OLMo-2-0425-1B-Instruct-q4f16_1-MLC": "over_budget",
        "Llama-3.2-1B-Instruct-q4f16_1-MLC": "eligible"
      },
      "default": "over_budget"
    },
    {
      "name": "a budget under the lightest entry admits nothing",
      "device": {
        "shader_f16": true,
        "max_buffer_size": 1073741824,
        "max_storage_buffer_binding_size": 1073741824,
        "max_compute_workgroup_storage_size": 65536,
        "max_storage_buffers_per_shader_stage": 10
      },
      "budget_mb": 376,
      "expected": {
        "Qwen3-0.6B-q4f16_1-MLC": "over_budget",
        "Qwen3-1.7B-q4f16_1-MLC": "over_budget",
        "SmolLM2-360M-Instruct-q4f16_1-MLC": "over_budget",
        "OLMo-2-0425-1B-Instruct-q4f16_1-MLC": "over_budget",
        "Llama-3.2-1B-Instruct-q4f16_1-MLC": "over_budget"
      },
      "default": "over_budget"
    },
    {
      "name": "no shader-f16 refuses every entry however large the budget",
      "device": {
        "shader_f16": false,
        "max_buffer_size": 1073741824,
        "max_storage_buffer_binding_size": 1073741824,
        "max_compute_workgroup_storage_size": 65536,
        "max_storage_buffers_per_shader_stage": 10
      },
      "budget_mb": 16384,
      "expected": {
        "Qwen3-0.6B-q4f16_1-MLC": "missing_shader_f16",
        "Qwen3-1.7B-q4f16_1-MLC": "missing_shader_f16",
        "SmolLM2-360M-Instruct-q4f16_1-MLC": "missing_shader_f16",
        "OLMo-2-0425-1B-Instruct-q4f16_1-MLC": "missing_shader_f16",
        "Llama-3.2-1B-Instruct-q4f16_1-MLC": "missing_shader_f16"
      },
      "default": "missing_shader_f16"
    },
    {
      "name": "the WebGPU default of eight storage buffers is below the runtime floor",
      "device": {
        "shader_f16": true,
        "max_buffer_size": 1073741824,
        "max_storage_buffer_binding_size": 1073741824,
        "max_compute_workgroup_storage_size": 65536,
        "max_storage_buffers_per_shader_stage": 8
      },
      "budget_mb": 16384,
      "expected": {
        "Qwen3-0.6B-q4f16_1-MLC": "below_runtime_floor:maxStorageBuffersPerShaderStage",
        "Qwen3-1.7B-q4f16_1-MLC": "below_runtime_floor:maxStorageBuffersPerShaderStage",
        "SmolLM2-360M-Instruct-q4f16_1-MLC": "below_runtime_floor:maxStorageBuffersPerShaderStage",
        "OLMo-2-0425-1B-Instruct-q4f16_1-MLC": "below_runtime_floor:maxStorageBuffersPerShaderStage",
        "Llama-3.2-1B-Instruct-q4f16_1-MLC": "below_runtime_floor:maxStorageBuffersPerShaderStage"
      },
      "default": "below_runtime_floor:maxStorageBuffersPerShaderStage"
    }
  ]
}
