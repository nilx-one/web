{
  "schema": 1,
  "deployOrder": ["web", "telegram", "discord"],
  "targets": {
    "web": {
      "app": "site",
      "root": "/srv/site",
      "edgeAlias": "nilxone-web",
      "compatEdgeAlias": "nilxone-web",
      "composeProject": "nilx-one-web",
      "publicPath": "/",
      "requiresIdentityContract": 9
    },
    "telegram": {
      "app": "telegram-mini-app",
      "root": "/srv/telegram-mini-app",
      "edgeAlias": "nilxone-telegram",
      "compatEdgeAlias": "nilxone-telegram",
      "composeProject": "nilx-one-telegram",
      "publicPath": "/telegram/",
      "requiresIdentityContract": 9
    },
    "discord": {
      "app": "discord-activity",
      "root": "/srv/discord-activity",
      "edgeAlias": "nilxone-discord",
      "compatEdgeAlias": "nilxone-discord",
      "composeProject": "nilx-one-discord",
      "publicPath": "/discord/",
      "requiresIdentityContract": 9
    }
  }
}
