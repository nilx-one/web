{
  "version": 8,
  "name": "0x1 spatial 0.1.0 · dark",
  "metadata": {
    "nilx-one:contract-version": "0.1.0",
    "nilx-one:basemap-url": "/map/0.1.0/basemap.pmtiles",
    "nilx-one:basemap-state": "regional-server-published",
    "nilx-one:coverage": "kyiv-bootstrap",
    "nilx-one:visual-language": "0x1-spatial",
    "nilx-one:visual-direction": "0x1 spatial map with restrained cyan accents",
    "nilx-one:appearance": "dark",
    "nilx-one:appearance-light-url": "/map/0.1.0/style.json",
    "nilx-one:appearance-dark-url": "/map/0.1.0/style-dark.json",
    "nilx-one:surface-background": "#070c0e",
    "nilx-one:surface-land": "#0b1215",
    "nilx-one:surface-parks": "#0e1a18",
    "nilx-one:surface-buildings": "#172126",
    "nilx-one:road-primary": "#26363c",
    "nilx-one:road-secondary": "#172126",
    "nilx-one:water-base": "#04191f",
    "nilx-one:accent-primary": "#37d7e5",
    "nilx-one:label-primary": "#a8b6bb",
    "nilx-one:label-secondary": "#6e7d83",
    "nilx-one:label-state": "reserved-pending-same-origin-glyphs",
    "nilx-one:accent-semantics": "presentation-only"
  },
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "pmtiles:///map/0.1.0/basemap.pmtiles",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#070c0e"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "basemap",
      "source-layer": "earth",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
        "fill-color": "#0b1215"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landcover",
      "maxzoom": 11,
      "paint": {
        "fill-color": [
          "match",
          ["get", "kind"],
          ["forest", "scrub", "grassland"],
          "#0e1a18",
          ["urban_area"],
          "#101a1e",
          "#0b1215"
        ],
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 4, 0.9, 10, 0.35]
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "filter": [
        "in",
        ["get", "kind"],
        [
          "literal",
          [
            "national_park",
            "park",
            "garden",
            "cemetery",
            "protected_area",
            "nature_reserve",
            "forest",
            "wood",
            "golf_course",
            "grass",
            "grassland",
            "scrub",
            "recreation_ground",
            "village_green",
            "allotments",
            "playground",
            "pitch"
          ]
        ]
      ],
      "paint": {
        "fill-color": "#0e1a18",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 6, 0, 10, 1]
      }
    },
    {
      "id": "landuse-urban",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "minzoom": 10,
      "filter": [
        "in",
        ["get", "kind"],
        [
          "literal",
          [
            "industrial",
            "hospital",
            "school",
            "university",
            "college",
            "pedestrian",
            "aerodrome",
            "military",
            "naval_base",
            "zoo"
          ]
        ]
      ],
      "paint": {
        "fill-color": "#172126",
        "fill-opacity": 0.45
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
        "fill-color": "#04191f"
      }
    },
    {
      "id": "water-accent",
      "type": "line",
      "source": "basemap",
      "source-layer": "water",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
        "line-color": "#37d7e5",
        "line-opacity": [
          "match",
          ["get", "kind"],
          ["river"],
          0.62,
          ["lake", "water"],
          0.4,
          0.32
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          0.3,
          10,
          0.9,
          14,
          1.8
        ]
      }
    },
    {
      "id": "rivers",
      "type": "line",
      "source": "basemap",
      "source-layer": "water",
      "minzoom": 8,
      "filter": [
        "all",
        ["==", ["geometry-type"], "LineString"],
        ["==", ["get", "kind"], "river"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#37d7e5",
        "line-opacity": 0.5,
        "line-width": [
          "interpolate",
          ["exponential", 1.6],
          ["zoom"],
          8,
          0.4,
          12,
          1.4,
          18,
          7
        ]
      }
    },
    {
      "id": "buildings-flat",
      "type": "fill",
      "source": "basemap",
      "source-layer": "buildings",
      "minzoom": 12,
      "maxzoom": 15,
      "filter": [
        "in",
        ["get", "kind"],
        ["literal", ["building", "building_part"]]
      ],
      "paint": {
        "fill-color": "#172126",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          12,
          0,
          13,
          0.65,
          14.5,
          0.65,
          15,
          0
        ]
      }
    },
    {
      "id": "roads-rail",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "minzoom": 12,
      "filter": ["==", ["get", "kind"], "rail"],
      "paint": {
        "line-color": "#26363c",
        "line-opacity": 0.5,
        "line-dasharray": [3, 2],
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.4, 18, 1.4]
      }
    },
    {
      "id": "roads-secondary",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "minzoom": 12,
      "filter": ["in", ["get", "kind"], ["literal", ["minor_road", "other"]]],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#172126",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          12,
          0.4,
          15,
          2,
          18,
          7
        ]
      }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "minzoom": 11,
      "filter": ["in", ["get", "kind"], ["literal", ["highway", "major_road"]]],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#0b1215",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          11,
          2,
          14,
          6,
          18,
          20
        ]
      }
    },
    {
      "id": "roads-primary",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "minzoom": 7,
      "filter": ["in", ["get", "kind"], ["literal", ["highway", "major_road"]]],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#26363c",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          7,
          0.5,
          11,
          1.2,
          14,
          3.4,
          18,
          12
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill-extrusion",
      "source": "basemap",
      "source-layer": "buildings",
      "minzoom": 14,
      "filter": [
        "in",
        ["get", "kind"],
        ["literal", ["building", "building_part"]]
      ],
      "paint": {
        "fill-extrusion-color": "#172126",
        "fill-extrusion-height": ["coalesce", ["get", "height"], 7],
        "fill-extrusion-base": ["coalesce", ["get", "min_height"], 0],
        "fill-extrusion-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          14,
          0,
          15,
          0.94
        ],
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "basemap",
      "source-layer": "boundaries",
      "minzoom": 4,
      "paint": {
        "line-color": "#6e7d83",
        "line-opacity": 0.3,
        "line-dasharray": [2, 2],
        "line-width": 0.6
      }
    },
    {
      "id": "pois",
      "type": "circle",
      "source": "basemap",
      "source-layer": "pois",
      "minzoom": 15,
      "paint": {
        "circle-radius": [
          "interpolate",
          ["linear"],
          ["zoom"],
          15,
          1.2,
          18,
          2.6
        ],
        "circle-color": "#6e7d83",
        "circle-opacity": 0.45
      }
    }
  ]
}
