      "source": "basemap",
      "source-layer": "water",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
        "line-color": "#37d7e5",
        "line-opacity": [
          "match",
          ["get", "kind_detail"],
          ["river", "riverbank"],
          0.7,
          ["lake", "reservoir"],
          0.46,
          0.36
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          0.35,
          10,
          1,
          14,
          1.9
        ]
      }
    },
    {
      "id": "rivers",
      "type": "line",
      "source": "basemap",
      "source-layer": "water",
      "minzoom": 8,
      "filter": [
        "all",
        ["==", ["geometry-type"], "LineString"],
        ["==", ["get", "kind_detail"], "river"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#37d7e5",
        "line-opacity": 0.56,
        "line-width": [
          "interpolate",
          ["exponential", 1.6],
          ["zoom"],
          8,
          0.45,
          12,
          1.5,
          18,
          7
        ]
      }
    },
