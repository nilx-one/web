        ["get", "kind"],
        ["literal", ["building", "building_part"]]
      ],
      "paint": {
        "fill-color": "#203036",
        "fill-outline-color": "#2a3c42",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10,
          0.12,
          11,
          0.28,
          12.5,
          0.5,
          15,
          0.62,
          16.5,
          0.5,
          19,
          0.42
        ]
      }
    },
