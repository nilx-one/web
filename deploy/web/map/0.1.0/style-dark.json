    "position": [1.4, 205, 32],
    "color": "#dff3f6",
    "intensity": 0.28
  },
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "pmtiles:///map/0.1.0/basemap.pmtiles",
      "attribution": "© OpenStreetMap contributors"
    },
    "terrain": {
      "type": "raster-dem",
      "tiles": ["/map/0.1.0/terrain/{z}/{x}/{y}.png"],
      "bounds": [29.75, 49.95, 31.35, 51.15],
      "minzoom": 8,
      "maxzoom": 12,
      "tileSize": 256,
      "encoding": "terrarium",
      "attribution": "Terrain: Mapzen/Tilezen · SRTM courtesy of U.S. Geological Survey · ETOPO1 U.S. NOAA"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#070c0e"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "basemap",
      "source-layer": "earth",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
        "fill-color": "#0c1417"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landcover",
      "maxzoom": 11,
      "paint": {
        "fill-color": [
          "match",
          ["get", "kind"],
          ["forest", "scrub", "grassland"],
          "#10201d",
          ["urban_area"],
          "#122126",
          "#0c1417"
        ],
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 4, 0.9, 10, 0.5]
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "filter": [
        "in",
        ["get", "kind"],
        [
          "literal",
          [
            "national_park",
            "park",
            "garden",
            "cemetery",
            "protected_area",
            "nature_reserve",
            "forest",
            "wood",
            "golf_course",
            "grass",
            "grassland",
            "scrub",
            "recreation_ground",
            "village_green",
            "allotments",
            "playground",
            "pitch"
          ]
        ]
      ],
      "paint": {
        "fill-color": "#10201d",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 6, 0, 10, 1]
      }
    },
    {
      "id": "landuse-urban",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "minzoom": 9,
      "filter": [
        "in",
        ["get", "kind"],
        [
          "literal",
          [
            "residential",
            "commercial",
            "industrial",
            "hospital",
            "school",
            "university",
            "college",
            "kindergarten",
            "pedestrian",
            "stadium",
            "aerodrome",
            "military",
            "zoo"
          ]
        ]
      ],
      "paint": {
        "fill-color": "#18282d",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          9,
          0.2,
          10,
          0.46,
          12,
          0.62
        ]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
        "fill-color": "#05222a"
      }
    },
    {
      "id": "water-accent",
