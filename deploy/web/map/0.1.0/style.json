{
  "version": 8,
  "name": "0x1 spatial 0.1.0 · light",
  "metadata": {
    "nilx-one:contract-version": "0.1.0",
    "nilx-one:basemap-url": "/map/0.1.0/basemap.pmtiles",
    "nilx-one:basemap-state": "regional-server-published",
    "nilx-one:coverage": "kyiv-bootstrap",
    "nilx-one:visual-language": "0x1-spatial",
    "nilx-one:visual-direction": "0x1 spatial map with restrained cyan accents",
    "nilx-one:appearance": "light",
    "nilx-one:appearance-light-url": "/map/0.1.0/style.json",
    "nilx-one:appearance-dark-url": "/map/0.1.0/style-dark.json",
    "nilx-one:surface-background": "#f7f9fa",
    "nilx-one:surface-land": "#f1f4f5",
    "nilx-one:surface-parks": "#eaf2ef",
    "nilx-one:surface-buildings": "#d8e2e5",
    "nilx-one:road-primary": "#bccfd4",
    "nilx-one:road-secondary": "#cedcdf",
    "nilx-one:water-base": "#d9f4f7",
    "nilx-one:accent-primary": "#37d7e5",
    "nilx-one:label-primary": "#536166",
    "nilx-one:label-secondary": "#7d8a90",
    "nilx-one:label-state": "reserved-pending-same-origin-glyphs",
    "nilx-one:accent-semantics": "presentation-only"
  },
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "pmtiles:///map/0.1.0/basemap.pmtiles",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f7f9fa"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "basemap",
      "source-layer": "earth",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
        "fill-color": "#f1f4f5"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landcover",
      "maxzoom": 11,
      "paint": {
        "fill-color": [
          "match",
          ["get", "kind"],
          ["forest", "scrub", "grassland"],
          "#eaf2ef",
          ["urban_area"],
          "#e8edef",
          "#f1f4f5"
        ],
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 4, 0.9, 10, 0.5]
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "filter": [
        "in",
        ["get", "kind"],
        [
          "literal",
          [
            "national_park",
            "park",
            "garden",
            "cemetery",
            "protected_area",
            "nature_reserve",
            "forest",
            "wood",
            "golf_course",
            "grass",
            "grassland",
            "scrub",
            "recreation_ground",
            "village_green",
            "allotments",
            "playground",
            "pitch"
          ]
        ]
      ],
      "paint": {
        "fill-color": "#eaf2ef",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 6, 0, 10, 1]
      }
    },
    {
      "id": "landuse-urban",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "minzoom": 9,
      "filter": [
        "in",
        ["get", "kind"],
        [
          "literal",
          [
            "residential",
            "commercial",
            "industrial",
            "hospital",
            "school",
            "university",
            "college",
            "kindergarten",
            "pedestrian",
            "stadium",
            "aerodrome",
            "military",
            "zoo"
          ]
        ]
      ],
      "paint": {
        "fill-color": "#e3eaec",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          9,
          0.18,
          10,
          0.42,
          12,
          0.58
        ]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
        "fill-color": "#d9f4f7"
      }
    },
    {
      "id": "water-accent",
      "type": "line",
      "source": "basemap",
      "source-layer": "water",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
        "line-color": "#37d7e5",
        "line-opacity": [
          "match",
          ["get", "kind_detail"],
          ["river", "riverbank"],
          0.62,
          ["lake", "reservoir"],
          0.4,
          0.32
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          0.35,
          10,
          1,
          14,
          1.9
        ]
      }
    },
    {
      "id": "rivers",
      "type": "line",
      "source": "basemap",
      "source-layer": "water",
      "minzoom": 8,
      "filter": [
        "all",
        ["==", ["geometry-type"], "LineString"],
        ["==", ["get", "kind_detail"], "river"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#37d7e5",
        "line-opacity": 0.5,
        "line-width": [
          "interpolate",
          ["exponential", 1.6],
          ["zoom"],
          8,
          0.45,
          12,
          1.5,
          18,
          7
        ]
      }
    },
    {
      "id": "buildings-flat",
      "type": "fill",
      "source": "basemap",
      "source-layer": "buildings",
      "minzoom": 10,
      "maxzoom": 15,
      "filter": [
        "in",
        ["get", "kind"],
        ["literal", ["building", "building_part"]]
      ],
      "paint": {
        "fill-color": "#d8e2e5",
        "fill-outline-color": "#c9d8dc",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10,
          0.12,
          11,
          0.28,
          12.5,
          0.55,
          14.5,
          0.62,
          15,
          0
        ]
      }
    },
    {
      "id": "roads-rail",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "minzoom": 11,
      "filter": ["==", ["get", "kind"], "rail"],
      "paint": {
        "line-color": "#c4d4d8",
        "line-opacity": 0.58,
        "line-dasharray": [3, 2],
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.3, 18, 1.5]
      }
    },
    {
      "id": "roads-secondary",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "minzoom": 10,
      "filter": ["==", ["get", "kind"], "minor_road"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#cedcdf",
        "line-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10,
          0.42,
          12,
          0.68,
          14,
          0.9
        ],
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          10,
          0.18,
          11,
          0.28,
          12,
          0.5,
          15,
          2,
          18,
          7
        ]
      }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "minzoom": 11,
      "filter": ["in", ["get", "kind"], ["literal", ["highway", "major_road"]]],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#eef2f3",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          11,
          2,
          14,
          6,
          18,
          20
        ]
      }
    },
    {
      "id": "roads-primary",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "minzoom": 7,
      "filter": ["in", ["get", "kind"], ["literal", ["highway", "major_road"]]],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#bccfd4",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          7,
          0.55,
          11,
          1.3,
          14,
          3.5,
          18,
          12
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill-extrusion",
      "source": "basemap",
      "source-layer": "buildings",
      "minzoom": 14,
      "filter": [
        "in",
        ["get", "kind"],
        ["literal", ["building", "building_part"]]
      ],
      "paint": {
        "fill-extrusion-color": "#d8e2e5",
        "fill-extrusion-height": ["coalesce", ["get", "height"], 7],
        "fill-extrusion-base": ["coalesce", ["get", "min_height"], 0],
        "fill-extrusion-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          14,
          0,
          15,
          0.92
        ],
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "basemap",
      "source-layer": "boundaries",
      "minzoom": 4,
      "paint": {
        "line-color": "#7d8a90",
        "line-opacity": 0.34,
        "line-dasharray": [2, 2],
        "line-width": 0.7
      }
    },
    {
      "id": "pois",
      "type": "circle",
      "source": "basemap",
      "source-layer": "pois",
      "minzoom": 14,
      "paint": {
        "circle-radius": [
          "interpolate",
          ["linear"],
          ["zoom"],
          14,
          0.8,
          18,
          2.6
        ],
        "circle-color": "#7d8a90",
        "circle-opacity": 0.36
      }
    }
  ]
}
