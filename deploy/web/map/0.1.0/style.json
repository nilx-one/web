{
  "version": 8,
  "name": "0x1 map 0.1.0",
  "metadata": {
    "nilx-one:contract-version": "0.1.0",
    "nilx-one:basemap-url": "/map/0.1.0/basemap.pmtiles",
    "nilx-one:basemap-state": "regional-server-published",
    "nilx-one:coverage": "kyiv-bootstrap",
    "nilx-one:visual-language": "mineral-light",
    "nilx-one:surface-background": "#f7f8f6",
    "nilx-one:surface-raised": "#eef0ef",
    "nilx-one:surface-shadow": "#c8cdcc",
    "nilx-one:geography-graphite": "#545b5c",
    "nilx-one:accent-primary": "#00d8f2",
    "nilx-one:accent-counterpart": "#ff7a1a",
    "nilx-one:accent-semantics": "presentation-only"
  },
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "pmtiles:///map/0.1.0/basemap.pmtiles",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f7f8f6"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#eef0e9",
        "fill-opacity": 0.72
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "paint": {
        "fill-color": "#d9ebee"
      }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "minzoom": 8,
      "paint": {
        "line-color": "#d5d9d8",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8,
          0.8,
          14,
          4,
          18,
          12
        ]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "minzoom": 8,
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8,
          0.45,
          14,
          2.4,
          18,
          8
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill-extrusion",
      "source": "basemap",
      "source-layer": "buildings",
      "minzoom": 14,
      "paint": {
        "fill-extrusion-color": "#d8dcdb",
        "fill-extrusion-height": ["coalesce", ["get", "height"], 7],
        "fill-extrusion-base": ["coalesce", ["get", "min_height"], 0],
        "fill-extrusion-opacity": 0.92
      }
    },
    {
      "id": "pois",
      "type": "circle",
      "source": "basemap",
      "source-layer": "pois",
      "minzoom": 14,
      "paint": {
        "circle-radius": [
          "interpolate",
          ["linear"],
          ["zoom"],
          14,
          1.5,
          18,
          3.5
        ],
        "circle-color": "#545b5c",
        "circle-opacity": 0.58
      }
    }
  ]
}
