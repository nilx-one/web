:1927 {
	encode zstd gzip

	route {
		@health path /health
		respond @health 200

		@identity_api path /auth /api/v1/identity /api/v1/identity/* /api/v1/auth/* /api/v1/location-control
		reverse_proxy @identity_api nilxone-identity:1927

		@avatar_assets path /avatars/*
		handle @avatar_assets {
			root * /srv
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		@monument_assets path /monuments/*
		handle @monument_assets {
			root * /srv
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# The PMTiles basemap is server-owned deployment data mounted read-only at
		# /srv/map-data (see contracts/services/nilxone-web.yaml); it is never baked
		# into the immutable client image the way style.json is. Match it ahead of
		# @map_assets so the versioned public path still resolves to the mounted
		# archive instead of falling through to a 404 under /srv/map.
		@basemap_archive path /map/0.1.0/basemap.pmtiles
		handle @basemap_archive {
			root * /srv/map-data
			header Cache-Control "public, max-age=86400"
			rewrite * /basemap.pmtiles
			file_server
		}

		@map_assets path /map/*
		handle @map_assets {
			root * /srv
			file_server
		}

		# Model artifacts live under an immutable revision directory, so every fetch after
		# the first is a cache hit until a revision is rolled forward. Same origin as the
		# app on purpose: no third party sees who is loading a model, and there is no CORS
		# negotiation between a person and their own avatar.
		@model_assets path /models/*
		handle @model_assets {
			root * /srv
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# Telegram Mini App is published below /telegram/, while its build output is
		# rooted at /srv/telegram-mini-app. Strip the public prefix before file lookup;
		# otherwise /telegram/assets/* would resolve to /srv/telegram-mini-app/telegram/*.
		@telegram_root path /telegram
		redir @telegram_root /telegram/ 308

		handle_path /telegram/* {
			root * /srv/telegram-mini-app
			try_files {path} /index.html
			file_server
		}

		handle {
			root * {$CLIENT_ROOT:/srv/site}
			try_files {path} /index.html
			file_server
		}
	}

	log {
		output stdout
		format json
	}
}
