:8080 {
	encode zstd gzip

	route {
		@health path /health
		respond @health 200

		@identity_api path /api/v1/identity /api/v1/identity/* /api/v1/auth/*
		reverse_proxy @identity_api ox1-identity:8080

		@map_assets path /map/*
		handle @map_assets {
			root * /srv
			file_server
		}

		handle {
			root * {$CLIENT_ROOT:/srv/site}
			try_files {path} /index.html
			file_server
		}
	}

	log {
		output stdout
		format json
	}
}
