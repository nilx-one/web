:8080 {
	encode zstd gzip

	route {
		@health path /health
		respond @health 200

		@identity_api path /api/v1/identity /api/v1/identity/* /api/v1/auth/*
		reverse_proxy @identity_api ox1-identity:8080

		@inactive_hosts path /telegram /telegram/* /discord /discord/*
		respond @inactive_hosts 404

		handle {
			root * /srv/site
			try_files {path} /index.html
			file_server
		}
	}

	log {
		output stdout
		format json
	}
}
