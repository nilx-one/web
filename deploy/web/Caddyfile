:8080 {
	encode zstd gzip

	route {
		@health path /health
		respond @health 200

		@identity_api path /auth /api/v1/identity /api/v1/identity/* /api/v1/auth/*
		reverse_proxy @identity_api ox1-identity:8080

		@avatar_assets path /avatars/*
		handle @avatar_assets {
			root * /srv
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		@map_assets path /map/*
		handle @map_assets {
			root * /srv
			file_server
		}

		# Model artifacts live under an immutable revision directory, so every fetch after
		# the first is a cache hit until a revision is rolled forward. Same origin as the
		# app on purpose: no third party sees who is loading a model, and there is no CORS
		# negotiation between a person and their own avatar.
		@model_assets path /models/*
		handle @model_assets {
			root * /srv
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle {
			root * {$CLIENT_ROOT:/srv/site}
			try_files {path} /index.html
			file_server
		}
	}

	log {
		output stdout
		format json
	}
}
